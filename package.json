{
  "name": "sbiz-app",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "node --check worker.js && node --check qa/mod01-cloudflare-access.test.mjs && node --check qa/mod01-slug-history-contract.test.mjs && node --check qa/node-cloudflare-compat-loader.mjs",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply sbiz-app-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply sbiz-app-db --remote",
    "test:access": "node --experimental-loader ./qa/node-cloudflare-compat-loader.mjs --test qa/mod01-cloudflare-access.test.mjs",
    "test:slug-history": "node --test qa/mod01-slug-history-contract.test.mjs"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
